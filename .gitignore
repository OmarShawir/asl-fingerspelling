# Local environments and tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Local recordings, participant metadata, and generated split lists
data/clips/
data/metadata.csv
data/.metadata-*.tmp
data/splits/*.txt
data/external/
data/cache/

# Downloaded landmark tracker and locally trained weights
models/*.task
models/*.pt
!models/mlp_static_final.pt
models/*.pth

# Local recognition session text and event logs
results/live_sessions/

# Original diagnostic camera PNGs and frame manifests
data/diagnostic_frames/

# Sequence payloads and experimental raw outputs
models/sequence/*
!models/sequence/gru_ctc_long_v1.pt
results/sequence/**/*_logits.npz

# Experimental sequence attempt text and frame logits
results/sequence_live_sessions/

# Private diagnostic galleries remain on this machine; publish only aggregate evidence.
/results/mn_diagnostic_2026-11-07/*
!/results/mn_diagnostic_2026-11-07/clip_predictions.csv
/results/s05_diagnostic/*
!/results/s05_diagnostic/comparison.csv
!/results/s05_diagnostic/per_letter.csv

# Final static report contains the per-clip evidence; omit redundant exports.
/results/final_static/*
!/results/final_static/README.md
!/results/final_static/report.json
!/results/final_static/manifest.json
!/results/final_static/history.json
!/results/final_static/*_per_letter.csv
/results/adaptation/s03_saved_checkpoint.*
/results/adaptation/s03_source_checkpoint.*

# Failed/debug runs and duplicated intermediate prediction exports stay local.
/results/sequence/gru_ctc_debug_attempt*/
/results/sequence/gru_ctc_pilot_v1/debug_ids.json
/results/sequence/gru_ctc_pilot_v1/debug_predictions.*
/results/sequence/gru_ctc_pilot_v1/debug_report.json
/results/sequence/gru_ctc_pilot_v1/learning_history.csv
/results/sequence/gru_ctc_pilot_v1/integrity.json
/results/sequence/gru_ctc_pilot_v1/run.log
/results/sequence/gru_ctc_long_v1/debug_*
/results/sequence/gru_ctc_long_v1/*_diagnostic/
/results/sequence/gru_ctc_long_v1/*training_predictions.*
/results/sequence/gru_ctc_long_v1/*training_edits.*
/results/sequence/gru_ctc_long_v1/learning_history.csv
/results/sequence/gru_ctc_long_v1/integrity.json
/results/sequence/gru_ctc_long_v1/protected_inputs_sha256.json
/results/sequence/gru_ctc_long_v1/run.log
/results/sequence/ctc_decode_v1/integrity.json
/results/sequence/ctc_decode_v1/camera_open_attempt.log
/results/sequence/ctc_decode_v1/selected_decoder.json

# Local authentication/configuration (never publish credentials).
.env
.env.*
!.env.example
kaggle.json
